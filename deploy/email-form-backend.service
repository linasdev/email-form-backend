[Unit]
Description=Email form backend
Documentation=https://github.com/linasdev/email-form-backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/email-form-backend

# The service reads config.toml from its working directory.
WorkingDirectory=/etc/email-form-backend
ConfigurationDirectory=email-form-backend

# Defaults first, so that the environment file below can override them.
Environment=RUST_LOG=info
# Secrets and per-host overrides (EMAIL_FORM_SMTP__PASSWORD=...). The leading
# "-" makes the file optional. systemd reads it as root, so mode 0600 is fine.
EnvironmentFile=-/etc/email-form-backend/environment

Restart=on-failure
RestartSec=5

# Run as a transient unprivileged user that exists only while the service runs.
DynamicUser=yes

# To listen on a port below 1024, uncomment these two lines.
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

# Sandboxing. The service only needs the network and read access to its config.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
